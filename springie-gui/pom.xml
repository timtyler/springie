<?xml version="1.0" encoding="UTF-8"?>
<!--
  Springie gui module: the AWT user interface.
  Depends on all lower layers (core, io, renderer, engine, base).
  This is the top of the module stack (below the app packaging).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.springie</groupId>
    <artifactId>springie-parent</artifactId>
    <version>1.03</version>
  </parent>

  <artifactId>springie-gui</artifactId>
  <name>Springie gui</name>
  <description>The Springie GUI: AWT user interface for the simulator.</description>

  <dependencies>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-base</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-renderer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-io</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
