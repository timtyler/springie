<?xml version="1.0" encoding="UTF-8"?>
<!--
  Derived from Tim's original Eclipse checkstyle configuration
  (.checkstyle_config, "Tim Checks", severity=warning), adapted for
  modern Checkstyle (run via maven-checkstyle-plugin during the build):
  - removed FileContentsHolder, RedundantThrows, DoubleCheckedLocking,
    JUnitTestCase, RequiredRegexp, StrictDuplicateCode and the usage.*
    checks (no longer shipped by Checkstyle);
  - TabCharacter -> FileTabCharacter (now a Checker-level module);
  - GenericIllegalRegexp -> RegexpSingleline (renamed, Checker-level).
  The original .checkstyle_config is left untouched.
-->
<!DOCTYPE module PUBLIC "-//Puppy Crawl//DTD Check Configuration 1.2//EN" "http://www.puppycrawl.com/dtds/configuration_1_2.dtd">
<module name="Checker">
<property name="severity" value="warning"/>
<module name="FileTabCharacter"></module>
<module name="RegexpSingleline">
  <!-- A disabled test must stay visible: every @Disabled is a warning,
       so a skipped test can't rot silently. Re-enable or delete it. -->
  <property name="format" value="^\s*@Disabled\b"/>
  <property name="message" value="Disabled test: re-enable it or delete it."/>
</module>

<module name="TreeWalker">

<module name="AvoidStarImport"></module>
<module name="IllegalImport"></module>
<module name="RedundantImport"></module>
<module name="UnusedImports"></module>
<module name="TypeName"></module>
<module name="EmptyForInitializerPad"></module>
<module name="EmptyForIteratorPad"></module>
<module name="NoWhitespaceBefore"></module>
<module name="OperatorWrap"></module>
<module name="MethodParamPad"></module>
<module name="ParenPad"></module>
<module name="TypecastParenPad"><property name="tokens" value="RPAREN,TYPECAST"/></module>
<module name="WhitespaceAfter"></module>
<module name="WhitespaceAround"></module>
<module name="RedundantModifier"></module>
<module name="EmptyBlock"></module>
<module name="LeftCurly"></module>
<module name="NeedBraces"></module>
<module name="RightCurly"></module>
<module name="CovariantEquals"></module>
<module name="DefaultComesLast"></module>
<module name="EmptyStatement"></module>
<module name="EqualsHashCode"></module>
<module name="FallThrough"></module>
