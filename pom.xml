<?xml version="1.0" encoding="UTF-8"?>
<!--
  Springie - tensegrity simulator.
  Builds the whole project (including the bundled com.tifsoft support
  classes that live under source/) with Maven.

  The historic source tree is kept in place: sources live under "source/"
  rather than Maven's default src/main/java, to avoid a 400-file move.

  Tests follow the Maven default layout: src/test/java.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.springie</groupId>
  <artifactId>springie</artifactId>
  <version>1.02-beta-5-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Springie</name>
  <description>A tensegrity simulator using Java.</description>
  <url>https://springie.com/</url>

  <licenses>
    <license>
      <name>Public Domain</name>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.3</junit.version>
  </properties>

  <build>
    <!-- Historic layout: everything already lives under source/. -->
    <sourceDirectory>source</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>false</addClasspath>
              <mainClass>com.springie.FrEnd</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
