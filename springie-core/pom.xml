<?xml version="1.0" encoding="UTF-8"?>
<!--
  Springie core module: the application library (everything except the
  base leaf packages and the demos). The executable jar is built by
  springie-app, which shades this together with the other modules.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.springie</groupId>
    <artifactId>springie-parent</artifactId>
    <version>1.03</version>
  </parent>

  <artifactId>springie</artifactId>
  <name>Springie</name>
  <description>A tensegrity simulator using Java.</description>

  <dependencies>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-base</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-renderer</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <!-- Skip the breakdown when checkstyle itself is skipped, so
               -Dcheckstyle.skip=true keeps working. -->
          <skip>${checkstyle.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-breakdown</id>
            <!-- Same phase as checkstyle, declared after it, so the results
                 file exists by the time this runs. -->
            <phase>validate</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <xslt in="${project.build.directory}/checkstyle-result.xml"
                      out="${project.build.directory}/checkstyle-breakdown.txt"
                      style="${maven.multiModuleProjectDirectory}/checkstyle-breakdown.xsl"/>
                <loadfile property="checkstyle.breakdown"
                          srcFile="${project.build.directory}/checkstyle-breakdown.txt"/>
                <echo message="${checkstyle.breakdown}" level="info"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
