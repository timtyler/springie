<?xml version="1.0" encoding="UTF-8"?>
<!--
  Springie engine module: the simulation core, with no dependencies on
  the render, GUI, or I/O packages. Packages: elements, world, muscles,
  context, scene, metrics, composite, plus base (geometry, constants,
  utilities).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.springie</groupId>
    <artifactId>springie-parent</artifactId>
    <version>1.03</version>
  </parent>

  <artifactId>springie-engine</artifactId>
  <name>Springie engine</name>
  <description>The Springie simulation engine: model, world, and scene assembly, independent of rendering and GUI.</description>

  <dependencies>
    <dependency>
      <groupId>com.springie</groupId>
      <artifactId>springie-base</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-io-for-tests</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.springie</groupId>
                  <artifactId>springie-io</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/io-test-classpath/main</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.springie</groupId>
                  <artifactId>springie-io</artifactId>
                  <version>${project.version}</version>
                  <classifier>tests</classifier>
                  <type>test-jar</type>
                  <outputDirectory>${project.build.directory}/io-test-classpath/test</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.springie</groupId>
                  <artifactId>springie-renderer</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/io-test-classpath/renderer</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.springie</groupId>
                  <artifactId>springie-presets</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/io-test-classpath/presets</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <additionalClasspathElements>
            <!-- The unpacked io/renderer/presets jars from above: io's
                 test registration first, so TestModelLoader shadows the
                 production DataInputModelLoader in the test JVM; the
                 presets unpack brings the cube.spr resource. -->
            <additionalClasspathElement>${project.build.directory}/io-test-classpath/test</additionalClasspathElement>
            <additionalClasspathElement>${project.build.directory}/io-test-classpath/main</additionalClasspathElement>
            <additionalClasspathElement>${project.build.directory}/io-test-classpath/renderer</additionalClasspathElement>
            <additionalClasspathElement>${project.build.directory}/io-test-classpath/presets</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
